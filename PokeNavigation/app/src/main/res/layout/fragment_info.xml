<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Información de la App"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PokeNavigation recreacion de taller Retrofit en Android para explorar Pokémon utilizando PokeAPI, consumo de servicios web con Retrofit, carga de imagenes con Glide y gestión de favoritos"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"/>

</LinearLayout>